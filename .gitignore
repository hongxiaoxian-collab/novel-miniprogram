# 依赖
node_modules/
*/node_modules/

# 构建产物
backend/dist/
dist/
*.tsbuildinfo
# 云函数部署包（含 node_modules，本地生成，不进代码仓）
backend/cloudfunctions/*.zip

# 本地数据库与备份（数据不进代码仓）
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-wal
backend/prisma/*.db-shm
*.sqlite
*.sqlite3

# 环境变量 / 密钥
.env
.env.local
.env.*.local

# 日志
*.log
logs/
backend/logs/
nohup.out

# 发布脚本的中间产物（PowerShell 上传脚本与日志）
deploy/.upload.ps1
deploy/.upload.log

# 临时验证产物（脚本跑出来的 json / 下载的包）
backend/scripts/*.json
backend/scripts/*.zip
backend/scripts/tmp/
*.tmp

# 本地排查/数据留底目录（章节导出等，不进代码仓）
.tmpdb/

# 系统垃圾
.DS_Store
Thumbs.db
nul
