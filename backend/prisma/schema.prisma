generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户（微信静默登录后自动创建）
// 【隐私铁律】只存 openid/unionid，不存头像、昵称、手机号、位置、设备标识。
// 真需要展示头像昵称时，走微信「头像昵称填写能力」由用户主动授权，且必须先在后台隐私指引里勾选对应项。
model User {
  id          String    @id @default(cuid())
  openid      String    @unique // 微信 openid：同一小程序内唯一，可识别到自然人，属个人信息
  unionid     String?   // 同一开放平台账号下唯一（绑定公众号/其他小程序后才有）
  level       String    @default("free") // 等级代码，对应 entitlement.ts 的 PLANS：free | vip | ...
  vipExpireAt DateTime? // 付费到期时间；为空=不过期。过期后 resolvePlan 自动降级回 free
  sessionKey  String?   // 微信 session_key（AES 加密存储）。虚拟支付下单要用它做用户态签名，丢了就付不了款。
                        // 属敏感凭证：不进日志、不出接口。
  quotaJson   String?   // JSON：手工覆盖的配额（运营调额用），未设则取套餐默认值
  status      String    @default("active") // active | banned（banned 后禁止写操作，数据保留便于申诉）
  // ---- 首次进入的「开书向导」----
  penName     String?   // 笔名：向导第④步确认一次，之后所有作品与封面自动带上
  authorIntro String?   // 作者简介（作家页 / 上架资料用）
  onboardJson String?   // JSON：向导五步进度 {download,register,realname,pen,contract}
  onboarded   Boolean   @default(false) // 向导走完才能进作品列表（首次进入强制走一次）
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  novels      Novel[]
  orders      Order[]
}

// 订单（微信支付接入后启用；现在只建表，不产生数据）
model Order {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode   String    // 套餐代码（vip_month / vip_year / ...）
  amount     Int       // 金额，单位：分
  status     String    @default("pending") // pending | paid | closed | refunded
  channel    String    @default("wxpay")   // wxpay | manual（人工开通/兑换码）
  outTradeNo String    @unique            // 我方订单号
  wxOrderNo  String?   // 微信支付订单号
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  @@index([userId])
}

// 作品（一本小说）
model Novel {
  id            String   @id @default(cuid())
  userId        String?  // 归属用户。可空：历史作品（登录功能上线前建的）保持 null 且对所有登录用户可见，
                         // 绝不能让作者一登录就发现老作品"不见了"
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKey      String?  // 游客匿名标识（未登录时建的作品挂在这里）。登录后会被"认领"到 userId 并清空。
  platform      String   // 'fanqie' | 'qimao'
  title         String
  penName       String?  // 笔名
  authorIntro   String?  // 作家简介
  coverImage    String?  // 封面「方案」JSON（canvas 兜底用：{v:2,plan,layout} / {v:1,seed}）
  coverFile     String?  // 真图封面在服务器上的相对路径（covers/xxx.jpg）。由生图底图 + 服务端叠字合成
  coverPrompt   String?  // 出这张封面用的生图提示词（可复现、可换字重出，不用重新生图）
  coverAt       DateTime? // 上次生成真图封面的时间
  genre         String?  // 题材（都市/玄幻/重生/机械…）
  intro         String?  // 作品简介（上架用，180-220 字）
  protagonists String?  // JSON：主要人物 [{name,role,desc}]
  targetReader  String?  // 男频/女频（七猫：男生/女生）
  // ---- 在写状态：每个平台同时最多 1 部「在写」，被拒后腾出名额 ----
  status        String   @default("writing") // writing(在写) | rejected(被拒) | archived(已归档/完结下架)
  rejectReason  String?  // 平台驳回原因（被拒时作者填/选，重开一本时作为 AI 避坑依据）
  rejectedAt    DateTime?
  parentId      String?  // 上一部作品的 id（被拒后自动重开的，指向被拒那本）
  autoCreated   Boolean  @default(false) // true = 「被拒后自动重开」生成的，不是作者手动建的
  timeline      String?  // 时间线（自动生成：分卷 × 真实时间锚点 × 关键事件，与大纲分开存便于单独展示）
  contractStatus String  @default("unsigned") // unsigned(未签约·默认) | signing(签约中) | signed(已签约)
  contractMode  String?  // 签约模式
  serialMode    String?  // 连载模式（连载中/日更等）
  tags          String?  // JSON：{reading:{主分类,主题,角色,情节}, content:{情节,情感,人设,世界观}}
  sellPoint     String?  // 一句话卖点
  outline       String?  // 大纲文本
  bible         String?  // JSON：全书脉络（故事圣经）完整结构
  bibleStatus   String   @default("none") // none | generating | done | failed
  chapterWords  Int      @default(2000) // 每章目标字数（用户可改，默认 2000）
  // ---- 定版任务（异步，前端轮询进度）----
  taskStage     String?  // running | done | failed（空闲为 null）
  taskLog       String?  // JSON：[{stage,label,status,error}]
  taskError     String?  // 失败原因
  dupReport     String?  // JSON：番茄/七猫撞车检测报告
  dupAccepted   String?  // 作者已选定的书名（重出大纲时锁死，不让 AI 改回去）
  dupCheckedAt  DateTime? // 上次联网查重的时间
  dupCheckedKey String?  // 查重时的内容指纹（书名|大纲长度|脉络长度）：指纹没变就复用，避免"上面说没撞、定版说撞了"
  canon         String?  // JSON：事实台账（累积快照）。写稿时强制注入，防止主角改名 / 时间线错乱 / 设定漂移
  // ---- AI 选题（扫榜 → 差异化金手指 → 3-5 个完整方案）----
  planDraft     Boolean  @default(false) // true=「AI 选题」占位作品，作者还没选定方案，列表里不出现
  planJson      String?  // JSON：扫榜结论 + 3-5 个完整开书方案
  // ---- 通用后台任务（体检 / 自动修复 / 续更 / 出大纲；退出小程序也继续跑，前端轮询进度）----
  jobKind       String?  // audit | fix | chapter | outline
  jobStage      String?  // running | done | failed（空闲为 null）
  jobLog        String?  // JSON：[{key,label,status,note,error}]
  jobError      String?
  jobResult     String?  // JSON：任务产出（如出大纲后的 {title,sellPoint,outline,staleCount}）
  jobAt         DateTime? // 任务心跳时间：服务重启后旧任务的 stage 会永远停在 running，靠它判定"孤儿任务"  // 失败原因
  auditJson     String?  // JSON：最近一次体检结果（含硬伤与 AI 语义问题）
  auditKey      String?  // 体检指纹：章节数+最新章id+更新时间+大纲版本。稿子没变就直接复用上次结果
  resolvedQuotes String? // JSON：已经修掉的矛盾指纹（normQuote）。重算体检时跳过，避免"修完冒出同一批"
  renamedJson   String? // JSON：{"旧写法":"新写法"}。人名/称谓统一过的映射 —— 全书一次改干净，残留还能硬扫出来 0 AI 修掉
  editMarksJson String? // JSON：最近一轮"定点修复"改过的句子 [{ch,text}]。收敛式复检只审这些改动处，不再全书重新找茬
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chapters      Chapter[]
  feedbacks     Feedback[]

  @@index([userId])
  @@index([guestKey])
}

/**
 * 平台反馈原始数据（被拒 / 过审）。
 *
 * 【为什么单独建表】作者从平台复制回来的拒稿原话，是唯一真实的外部裁判信号 ——
 * 我们自己的体检再准也只是"自评"。这批数据必须留全：驳回原文 + 当时的作品快照 + AI 总结，
 * 以后改写作规则（铁律 / 判据权重）时拿它对表，而不是凭印象拍脑袋。
 *
 * 【铁律】只增不删：即使后来改稿重过，那条被拒记录也照留（它是样本，不是状态）。
 */
model Feedback {
  id           String   @id @default(cuid())
  novelId      String
  novel        Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  userId       String?
  guestKey     String?
  platform     String   // fanqie | qimao
  kind         String   // rejected(被平台拒) | passed(过审/通过)
  reason       String   @default("") // 平台驳回原文（作者从平台复制粘贴，一字不改）
  snapshot     String?  // JSON：当时的作品快照（书名/卖点/男女频/题材/大纲/简介/标签）
  summary      String?  // AI 总结：归到哪一类短板 + 下次怎么避免（沉淀成写作规则的依据）
  chapterCount Int      @default(0) // 被拒时已写了几章
  wordCount    Int      @default(0) // 被拒时已写了多少字
  createdAt    DateTime @default(now())

  @@index([novelId])
  @@index([kind])
}

// 章节
/// 真实联网检索到的在榜作品（本地"撞车比对库"）：查重不再靠 AI 凭印象编作品名
model HotBook {
  id        String   @id @default(cuid())
  title     String
  snippet   String   @default("")   // 搜索结果里的真实原文摘录（给作者核对用）
  url       String   @default("")
  source    String   @default("bing")
  query     String   @default("")   // 当初用哪个词搜到的
  hits      Int      @default(1)    // 被检索到的次数
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  volume    Int      @default(1) // 卷号（卷一/卷二/卷三…）
  order     Int      // 章序号（全局递增）
  title     String
  content   String?  // 正文
  summary   String?  // 滚动摘要（带入下章防断链）
  canon     String?  // JSON：本章更新的事实台账（增量，合并进 Novel.canon）
  stale     Boolean  @default(false) // 大纲/设定已变更 → 旧章节作废（不删数据，仅隐藏，避免两套设定混装）
  status    String   @default("draft") // draft | done
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([novelId])
}
