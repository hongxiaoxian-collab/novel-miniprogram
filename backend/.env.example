# 后端端口（测试服建议 3001，避免与 ERP 的 3000 冲突）
PORT=3001

# SQLite 数据库文件位置
DATABASE_URL="file:./novel.db"

# 扣子(Coze) 配置（仅服务端，绝不进小程序）
# 个人访问令牌：https://www.coze.cn/open/oauth/pats
COZE_API_KEY=""
# 你在 Coze 创建并发布到 API 的 bot id
COZE_BOT_ID=""
# Coze API 基地址（国内默认）
COZE_API_BASE="https://api.coze.cn"
# 透传给 Coze 的用户标识（单用户可固定）
COZE_USER_ID="novel-app-user"

# ---- 微信云开发 CloudBase（深度合成类目资质来源；配了就优先用它，不配自动回落扣子）----
# 三种通道按优先级择一：① 云函数代理 > ② Node SDK > ③ HTTP 直连
#
# ① 【推荐】云函数代理：云函数 ai-write 的 HTTP 触发地址。
#    成长计划的免费 Token 只认「小程序端 / 云开发服务端 SDK」两种来源，
#    自有服务器用 API Key 直连会被拒（AI_CHANNEL_NOT_ALLOWED）。
CLOUDBASE_FN_URL=""
# 云函数环境变量 AI_WRITE_TOKEN 里填的同一个口令（防止 URL 泄露后被白嫖）
CLOUDBASE_FN_TOKEN=""
#
# ② Node SDK 直连：需腾讯云 CAM 密钥 https://console.cloud.tencent.com/cam/capi
# CLOUDBASE_SECRET_ID=""
# CLOUDBASE_SECRET_KEY=""
#
# ③ HTTP 直连（成长计划环境会返回 AI_CHANNEL_NOT_ALLOWED，仅非成长计划环境可用）
# 环境 ID：CloudBase 控制台首页「环境 ID」处复制，形如 zhicheng-novel-xxxxxxxx
CLOUDBASE_ENV_ID=""
# API Key：控制台 → 环境管理 → 环境配置 → API Key 配置（明文只显示一次，当场复制）
# ⚠️ 等于环境的读写钥匙，不要外传、不要进前端或代码仓库
CLOUDBASE_API_KEY=""
# 生文模型名，默认 hy3（需先在 控制台 → AI → 生文模型 里打开开关）
CLOUDBASE_MODEL="hy3"

# ---- 微信登录（不填则整套账号功能自动停用，行为与加登录前完全一致）----
# 公众平台 mp.weixin.qq.com → 开发 → 开发管理 → 开发设置 → 开发者ID
WX_APPID=""
# AppSecret 只在生成时展示一次，务必先保存再离开页面
WX_APP_SECRET=""
# 登录凭证签名密钥。生产环境一定要换成随机长字符串，不要留空
AUTH_SECRET=""
