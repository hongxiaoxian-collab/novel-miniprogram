# 后端端口（测试服建议 3001，避免与 ERP 的 3000 冲突）
PORT=3001

# SQLite 数据库文件位置
DATABASE_URL="file:./novel.db"

# 扣子(Coze) 配置（仅服务端，绝不进小程序）
# 个人访问令牌：https://www.coze.cn/open/oauth/pats
COZE_API_KEY=""
# 你在 Coze 创建并发布到 API 的 bot id
COZE_BOT_ID=""
# Coze API 基地址（国内默认）
COZE_API_BASE="https://api.coze.cn"
# 透传给 Coze 的用户标识（单用户可固定）
COZE_USER_ID="novel-app-user"
