.card { background:#fff; border-radius:16rpx; margin:20rpx 24rpx; padding:24rpx; box-shadow:0 2rpx 12rpx rgba(0,0,0,.05); }
.card-h { font-size:30rpx; font-weight:700; margin-bottom:14rpx; }
.row { display:flex; align-items:center; justify-content:space-between; }
.k { color:#888; font-size:26rpx; }
.v { font-size:26rpx; color:#333; }
.muted { color:#888; font-size:26rpx; line-height:1.6; }
.btn { background:#07c160; color:#fff; text-align:center; padding:22rpx; border-radius:12rpx; margin:20rpx 24rpx; font-size:30rpx; }
.btn.ghost { background:#fff; color:#07c160; border:2rpx solid #07c160; }
.btn.blue { color:#2b6cff; border-color:#2b6cff; }
.tl { display:flex; padding:14rpx 0; border-top:2rpx solid #f2f2f2; }
.tl-left { width:90rpx; flex:none; }
.tl-no { font-weight:700; font-size:28rpx; }
.tl-body { flex:1; }
.tl-name { font-weight:600; font-size:28rpx; }
.tl-event { color:#8a6d00; font-size:26rpx; margin-top:4rpx; }
.tl-sub { color:#888; font-size:24rpx; margin-top:4rpx; }
