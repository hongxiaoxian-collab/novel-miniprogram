.page { padding: 24rpx; }
.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 24rpx;
}
.row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; }
.k { font-size: 28rpx; color: #666; }
.v { font-size: 28rpx; color: #222; }
.strong { font-weight: 600; color: #07c160; }
.muted { font-size: 26rpx; color: #999; }
.tip { margin-top: 12rpx; line-height: 1.6; }
.btns { margin-top: 8rpx; }
.btn {
  text-align: center; padding: 22rpx 0; border-radius: 12rpx;
  font-size: 30rpx; margin-bottom: 20rpx;
}
.ghost { background: #f2f3f5; color: #333; }
.danger { background: #fdecec; color: #e64340; }
