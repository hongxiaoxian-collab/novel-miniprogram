/* 封面（竖版 3:4） */
.coverwrap {
  width: 420rpx; height: 560rpx; margin: 24rpx auto 12rpx;
  border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .18);
}
.cover-canvas { width: 100%; height: 100%; }
.cover-img { width: 100%; height: 100%; display: block; background: #111; }

.note {
  background: #fff8e6; border: 2rpx solid #ffe08a; color: #8a6d00;
  font-size: 24rpx; padding: 16rpx 20rpx; margin: 16rpx 24rpx; border-radius: 12rpx;
}

/* 字段标题 / 值 */
.k { font-size: 24rpx; color: #888; }
.v { font-size: 28rpx; color: #1a1a1a; margin-top: 8rpx; line-height: 1.6; }
.v.big { font-size: 34rpx; font-weight: 600; }
.kv { display: flex; align-items: center; justify-content: space-between; }

/* 人物行 */
.prow {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 0; border-bottom: 2rpx solid #f2f2f2;
}
.prow:last-child { border-bottom: none; }
.pinfo { display: flex; align-items: baseline; flex: 1; margin-right: 16rpx; overflow: hidden; }
.pname { font-size: 30rpx; font-weight: 600; color: #1a1a1a; margin-right: 12rpx; }
.prole { font-size: 22rpx; color: #07c160; background: #eef9f1; border-radius: 16rpx; padding: 2rpx 12rpx; margin-right: 12rpx; }
.pdesc { font-size: 24rpx; color: #999; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 笔名候选（AI 一次给 ≥3 个，点选即用，可换一批） */
.pickrow { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.pickchip {
  font-size: 26rpx; color: #333; background: #f2f4f7;
  border: 2rpx solid #e2e6ec; border-radius: 999rpx;
  padding: 10rpx 24rpx; margin: 0 12rpx 12rpx 0;
}
.pickchip.on { background: #e8f8ef; border-color: #07c160; color: #07a352; font-weight: 600; }
/* 体检遗留问题的角标提醒 */
.badge { margin-left: 12rpx; font-size: 22rpx; color: #fff; background: #e64340;
  border-radius: 999rpx; padding: 4rpx 14rpx; }

/* 被拒 / 过审状态条 */
.rejbar {
  margin: 16rpx 24rpx 0; padding: 18rpx 20rpx; border-radius: 12rpx;
  background: #fff5f4; border: 2rpx solid #ffd9d4; color: #c0392b; font-size: 25rpx; line-height: 1.7;
}
.rejbtn {
  display: inline-block; margin-top: 12rpx; color: #fff; background: #e64340;
  font-size: 26rpx; font-weight: 600; padding: 10rpx 26rpx; border-radius: 999rpx;
}
.passbar {
  margin: 16rpx 24rpx 0; padding: 18rpx 20rpx; border-radius: 12rpx;
  background: #eaf9ef; border: 2rpx solid #b7e7c8; color: #0a7a44; font-size: 25rpx;
}

/* 被拒原因浮层 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .45); z-index: 99;
  display: flex; align-items: flex-end; justify-content: center;
}
.sheet {
  width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx 40rpx; box-sizing: border-box; max-height: 88vh; overflow-y: auto;
}
.sheet-h { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
