/* 标识必须"显著"：橙色实心徽标 + 浅底描边，在任何页面背景上都一眼可见 */
.ainote {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 24rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #ffd591;
  background: #fff7e6;
  border-radius: 12rpx;
}
.ainote.compact {
  margin: 10rpx 0;
  padding: 10rpx 14rpx;
}
.ai-badge {
  flex: none;
  margin-right: 12rpx;
  padding: 4rpx 12rpx;
  background: #ff8f1f;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.7;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}
.ai-txt {
  flex: 1;
  color: #8a5a00;
  font-size: 22rpx;
  line-height: 1.6;
}
