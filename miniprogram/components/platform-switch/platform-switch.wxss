.seg { display: flex; background: rgba(255,255,255,.25); border-radius: 36rpx; padding: 6rpx; width: 280rpx; }
.opt { flex: 1; text-align: center; padding: 10rpx 0; font-size: 26rpx; border-radius: 30rpx; color: #fff; }
.opt.on { background: #fff; color: #07c160; font-weight: 600; }
.seg.dark .opt.on { color: #2b6cff; }
